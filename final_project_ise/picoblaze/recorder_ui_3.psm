                COMPARE s9, 00
                JUMP    Z, volume_bar_00
                COMPARE s9, 01
                JUMP    Z, volume_bar_01
                COMPARE s9, 02
                JUMP    Z, volume_bar_02
                COMPARE s9, 03
                JUMP    Z, volume_bar_03
