send_crlf:
                LOAD    s3, ascii_CR
                CALL    send_uart_byte
                LOAD    s3, ascii_LF
                CALL    send_uart_byte
                RETURN

send_uart_byte:
                INPUT   s2, buffer_full
                TEST    s2, 01
                JUMP    NZ, send_uart_byte
                OUTPUT  s3, uart_data_tx
                RETURN
