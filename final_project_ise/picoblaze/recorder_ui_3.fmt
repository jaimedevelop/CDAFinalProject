                   CONSTANT ascii_l, 6C
                   CONSTANT ascii_m, 6D
                   CONSTANT ascii_n, 6E
                   CONSTANT ascii_o, 6F
                   CONSTANT ascii_p, 70
                   CONSTANT ascii_r, 72
                   CONSTANT ascii_s, 73
                   CONSTANT ascii_t, 74
                   CONSTANT ascii_u, 75
                   CONSTANT ascii_v, 76
                   CONSTANT ascii_w, 77
                   CONSTANT ascii_y, 79
       cold_start: 
                   CALL send_crlf
                   CALL print_welcome
        main_menu: 
                   CALL send_crlf
                   CALL print_menu
   wait_for_input: 
                   INPUT s1, data_present
                   TEST s1, 01
                   JUMP Z, wait_for_input
                   INPUT s3, uart_data_rx
                   CALL send_uart_byte
                   CALL send_crlf
                   COMPARE s3, ascii_1
                   JUMP Z, do_play
                   COMPARE s3, ascii_2
                   JUMP Z, do_record
                   COMPARE s3, ascii_3
                   JUMP Z, do_delete
                   COMPARE s3, ascii_4
                   JUMP Z, do_delete_all
                   COMPARE s3, ascii_5
                   JUMP Z, do_volume
                   JUMP invalid_selection
          do_play: 
                   CALL print_play
                   JUMP main_menu
        do_record: 
                   CALL print_record
                   JUMP main_menu
        do_delete: 
                   CALL print_delete
                   JUMP main_menu
    do_delete_all: 
                   CALL print_delete_all
                   JUMP main_menu
        do_volume: 
                   CALL print_volume
                   JUMP main_menu
invalid_selection: 
                   CALL print_invalid
                   JUMP main_menu
    print_welcome: 
