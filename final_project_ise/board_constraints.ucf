# board_constraints.ucf
# Merged pin assignments for the Anvyl board.
#
# Clock topology (see CLOCK_DOMAIN_MAP.txt for full plan):
#   Board oscillator  →  DDR2 RAM interface  →  clkout (37.5 MHz)
#   clkout            →  project_clk_wiz_37p5_to_100  →  100 MHz (PicoBlaze/UART)
#                                                      →  100 MHz (codec-side)
#   codec-side 100 MHz  →  clk_wiz_v3_6  →  50 MHz, ~11.2896 MHz
#
# Sources merged: audio reference, DDR2 reference, Lab 6 reference.
# Duplicate pin assignments resolved; no pin is used twice.

# ── Primary oscillator ───────────────────────────────────────────────────────
NET board_clk_100mhz TNM_NET = primary_osc;
TIMESPEC TS_primary_osc = PERIOD primary_osc 100000 kHz;
NET board_clk_100mhz LOC = D11 | IOSTANDARD = LVCMOS33;

# ── Global reset and serial console ─────────────────────────────────────────
NET sys_reset   LOC = E6;
NET uart_tx     LOC = T20;
NET uart_rx     LOC = T19;

# ── SSM2603 audio codec ──────────────────────────────────────────────────────
NET codec_dac_data   LOC = A5  | IOSTANDARD = LVCMOS33;
NET codec_dac_lrclk  LOC = D6  | IOSTANDARD = LVCMOS33;
NET codec_adc_data   LOC = C6  | IOSTANDARD = LVCMOS33;
NET codec_adc_lrclk  LOC = B6  | IOSTANDARD = LVCMOS33;
NET codec_mute_n     LOC = A15 | IOSTANDARD = LVCMOS33;
NET codec_mclk       LOC = A6  | IOSTANDARD = LVCMOS33;
NET codec_bclk       LOC = B12 | IOSTANDARD = LVCMOS33;
NET codec_i2c_sda    LOC = C5  | PULLUP | IOSTANDARD = LVCMOS33;
NET codec_i2c_scl    LOC = A4  | PULLUP | IOSTANDARD = LVCMOS33;

# ── Push buttons ─────────────────────────────────────────────────────────────
# btn_press[0..2] map to the three non-reset Anvyl buttons.
# BTN0 (reset) is driven by sys_reset above.
NET "btn_press[0]" LOC = D5  | IOSTANDARD = LVCMOS18;
NET "btn_press[1]" LOC = A3  | IOSTANDARD = LVCMOS18;
NET "btn_press[2]" LOC = AB9 | IOSTANDARD = LVCMOS33;

# ── Slide switches (SW0..SW3, true Anvyl master-UCF mapping) ─────────────────
NET "slide_sw[0]" LOC = V5 | IOSTANDARD = LVCMOS18;
NET "slide_sw[1]" LOC = U4 | IOSTANDARD = LVCMOS18;
NET "slide_sw[2]" LOC = V3 | IOSTANDARD = LVCMOS18;
NET "slide_sw[3]" LOC = P4 | IOSTANDARD = LVCMOS18;

# ── DIP switches (from DDR2 reference design) ────────────────────────────────
NET "dip_sw[0]" LOC = G6 | IOSTANDARD = LVCMOS18;
NET "dip_sw[1]" LOC = G4 | IOSTANDARD = LVCMOS18;
NET "dip_sw[2]" LOC = F5 | IOSTANDARD = LVCMOS18;
NET "dip_sw[3]" LOC = E5 | IOSTANDARD = LVCMOS18;
NET "dip_sw[4]" LOC = F8 | IOSTANDARD = LVCMOS18;
NET "dip_sw[5]" LOC = F7 | IOSTANDARD = LVCMOS18;
NET "dip_sw[6]" LOC = C4 | IOSTANDARD = LVCMOS18;
NET "dip_sw[7]" LOC = D3 | IOSTANDARD = LVCMOS18;

# ── Status LEDs ──────────────────────────────────────────────────────────────
NET "status_led[0]" LOC = W3;
NET "status_led[1]" LOC = Y4;
NET "status_led[2]" LOC = Y1;
NET "status_led[3]" LOC = Y3;
NET "status_led[4]" LOC = AB4;
NET "status_led[5]" LOC = W1;
NET "status_led[6]" LOC = AB3;
NET "status_led[7]" LOC = AA4;

# ── DDR2 SDRAM ───────────────────────────────────────────────────────────────
CONFIG MCB_PERFORMANCE = STANDARD;

NET "ddr2_ck_p"   LOC = F2 | IOSTANDARD = DIFF_SSTL2_II;
NET "ddr2_ck_n"   LOC = F1 | IOSTANDARD = DIFF_SSTL2_II;
NET "ddr2_cke"    LOC = J6;
NET "ddr2_cas_n"  LOC = P3;
NET "ddr2_ldm"    LOC = H1;
NET "ddr2_odt"    LOC = M3;
NET "ddr2_ras_n"  LOC = N4;
NET "ddr2_udm"    LOC = H2;
NET "ddr2_we_n"   LOC = D2;

NET "ddr2_ldqs_n" LOC = L1 | IOSTANDARD = DIFF_SSTL2_II;
NET "ddr2_ldqs_p" LOC = L3 | IOSTANDARD = DIFF_SSTL2_II;
NET "ddr2_udqs_n" LOC = T1 | IOSTANDARD = DIFF_SSTL2_II;
NET "ddr2_udqs_p" LOC = T2 | IOSTANDARD = DIFF_SSTL2_II;

NET "ddr2_dq[0]"  LOC = N3;
NET "ddr2_dq[1]"  LOC = N1;
NET "ddr2_dq[2]"  LOC = M2;
NET "ddr2_dq[3]"  LOC = M1;
NET "ddr2_dq[4]"  LOC = J3;
NET "ddr2_dq[5]"  LOC = J1;
NET "ddr2_dq[6]"  LOC = K2;
NET "ddr2_dq[7]"  LOC = K1;
NET "ddr2_dq[8]"  LOC = P2;
NET "ddr2_dq[9]"  LOC = P1;
NET "ddr2_dq[10]" LOC = R3;
NET "ddr2_dq[11]" LOC = R1;
NET "ddr2_dq[12]" LOC = U3;
NET "ddr2_dq[13]" LOC = U1;
NET "ddr2_dq[14]" LOC = V2;
NET "ddr2_dq[15]" LOC = V1;
NET "ddr2_dq[*]"  IOSTANDARD = SSTL2_II;
NET "ddr2_dq[*]"  IN_TERM = NONE;

NET "ddr2_addr[0]"  LOC = M5;
NET "ddr2_addr[1]"  LOC = L4;
NET "ddr2_addr[2]"  LOC = K3;
NET "ddr2_addr[3]"  LOC = M4;
NET "ddr2_addr[4]"  LOC = K5;
NET "ddr2_addr[5]"  LOC = G3;
NET "ddr2_addr[6]"  LOC = G1;
NET "ddr2_addr[7]"  LOC = K4;
NET "ddr2_addr[8]"  LOC = C3;
NET "ddr2_addr[9]"  LOC = C1;
NET "ddr2_addr[10]" LOC = K6;
NET "ddr2_addr[11]" LOC = B1;
NET "ddr2_addr[12]" LOC = J4;
NET "ddr2_addr[*]"  IOSTANDARD = SSTL2_II;

NET "ddr2_ba[0]" LOC = E3;
NET "ddr2_ba[1]" LOC = E1;
NET "ddr2_ba[2]" LOC = D1;
NET "ddr2_ba[*]" IOSTANDARD = SSTL2_II;

# ── MIG calibration timing exceptions ────────────────────────────────────────
NET "*/memc3_wrapper_inst/mcb_ui_top_inst/mcb_raw_wrapper_inst/selfrefresh_mcb_mode" TIG;
NET "*/c?_pll_lock" TIG;
INST "*/memc?_wrapper_inst/mcb_ui_top_inst/mcb_raw_wrapper_inst/gen_term_calib.mcb_soft_calibration_top_inst/mcb_soft_calibration_inst/DONE_SOFTANDHARD_CAL*" TIG;
NET "*/memc?_wrapper_inst/mcb_ui_top_inst/mcb_raw_wrapper_inst/gen_term_calib.mcb_soft_calibration_top_inst/mcb_soft_calibration_inst/CKE_Train" TIG;