NET "switches[1]" LOC = "P5";
NET "switches[0]" LOC = "P8";

NET "leds[7]" LOC = "W3";
NET "leds[6]" LOC = "Y4";
NET "leds[5]" LOC = "Y1";
NET "leds[4]" LOC = "Y3";
NET "leds[3]" LOC = "AB4";
