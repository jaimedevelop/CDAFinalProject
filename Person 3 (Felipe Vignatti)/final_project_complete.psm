                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_t
                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_d
                CALL    send_uart_byte
                LOAD    s0, ascii_PERIOD
                CALL    send_uart_byte
                CALL    print_newline
                RETURN

; "All messages deleted."
print_all_deleted:
                LOAD    s0, ascii_A
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                LOAD    s0, ascii_d
                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_t
                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_d
                CALL    send_uart_byte
                LOAD    s0, ascii_PERIOD
                CALL    send_uart_byte
                CALL    print_newline
                RETURN

; "Cancelled."
print_cancelled:
                LOAD    s0, ascii_C
                CALL    send_uart_byte
                LOAD    s0, ascii_a
                CALL    send_uart_byte
                LOAD    s0, ascii_n
                CALL    send_uart_byte
                LOAD    s0, ascii_c
                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_e
                CALL    send_uart_byte
                LOAD    s0, ascii_d
                CALL    send_uart_byte
                LOAD    s0, ascii_PERIOD
                CALL    send_uart_byte
                CALL    print_newline
                RETURN

; "Invalid input."
print_invalid:
                LOAD    s0, ascii_I
                CALL    send_uart_byte
                LOAD    s0, ascii_n
                CALL    send_uart_byte
                LOAD    s0, ascii_v
                CALL    send_uart_byte
                LOAD    s0, ascii_a
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_i
                CALL    send_uart_byte
                LOAD    s0, ascii_d
                CALL    send_uart_byte
                LOAD    s0, ascii_PERIOD
                CALL    send_uart_byte
                CALL    print_newline
                RETURN

; "-- VOLUME CONTROL --"
print_volume_header:
                LOAD    s0, ascii_MINUS
                CALL    send_uart_byte
                CALL    send_uart_byte
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                LOAD    s0, ascii_V
                CALL    send_uart_byte
                LOAD    s0, ascii_O
                CALL    send_uart_byte
                LOAD    s0, ascii_L
                CALL    send_uart_byte
                LOAD    s0, ascii_U
                CALL    send_uart_byte
                LOAD    s0, ascii_M
                CALL    send_uart_byte
                LOAD    s0, ascii_E
                CALL    send_uart_byte
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                LOAD    s0, ascii_C
                CALL    send_uart_byte
                LOAD    s0, ascii_O
                CALL    send_uart_byte
                LOAD    s0, ascii_N
                CALL    send_uart_byte
                LOAD    s0, ascii_T
                CALL    send_uart_byte
                LOAD    s0, ascii_R
                CALL    send_uart_byte
                LOAD    s0, ascii_O
                CALL    send_uart_byte
                LOAD    s0, ascii_L
                CALL    send_uart_byte
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                LOAD    s0, ascii_MINUS
                CALL    send_uart_byte
                CALL    send_uart_byte
                CALL    print_newline
                RETURN

; Prints "Vol: [====    ] " based on current level in scratchpad 40
print_volume_bar:
                LOAD    s0, ascii_V
                CALL    send_uart_byte
                LOAD    s0, ascii_o
                CALL    send_uart_byte
                LOAD    s0, ascii_l
                CALL    send_uart_byte
                LOAD    s0, ascii_COLON
                CALL    send_uart_byte
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                LOAD    s0, ascii_LBKT
                CALL    send_uart_byte

                FETCH   sC, 40          ; sC = current volume (0-8)
                LOAD    sD, 00          ; sD = bar position counter

vol_bar_loop:
                COMPARE sD, sC
                JUMP    NC, vol_bar_empty
                LOAD    s0, ascii_EQUAL
                CALL    send_uart_byte
                ADD     sD, 01
                COMPARE sD, 08
                JUMP    NZ, vol_bar_loop
                JUMP    vol_bar_done

vol_bar_empty:
                COMPARE sD, 08
                JUMP    Z, vol_bar_done
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                ADD     sD, 01
                JUMP    vol_bar_empty

vol_bar_done:
                LOAD    s0, ascii_RBKT
                CALL    send_uart_byte
                CALL    print_newline
                RETURN

; "[u]p [d]own [b]ack"
print_volume_controls:
                LOAD    s0, ascii_LBKT
                CALL    send_uart_byte
                LOAD    s0, ascii_u
                CALL    send_uart_byte
                LOAD    s0, ascii_RBKT
                CALL    send_uart_byte
                LOAD    s0, ascii_u
                CALL    send_uart_byte
                LOAD    s0, ascii_p
                CALL    send_uart_byte
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                LOAD    s0, ascii_LBKT
                CALL    send_uart_byte
                LOAD    s0, ascii_d
                CALL    send_uart_byte
                LOAD    s0, ascii_RBKT
                CALL    send_uart_byte
                LOAD    s0, ascii_d
                CALL    send_uart_byte
                LOAD    s0, ascii_o
                CALL    send_uart_byte
                LOAD    s0, ascii_w
                CALL    send_uart_byte
                LOAD    s0, ascii_n
                CALL    send_uart_byte
                LOAD    s0, ascii_SPACE
                CALL    send_uart_byte
                LOAD    s0, ascii_LBKT
                CALL    send_uart_byte
                LOAD    s0, ascii_b
                CALL    send_uart_byte
                LOAD    s0, ascii_RBKT
                CALL    send_uart_byte
                LOAD    s0, ascii_b
                CALL    send_uart_byte
                LOAD    s0, ascii_a
                CALL    send_uart_byte
                LOAD    s0, ascii_c
                CALL    send_uart_byte
                LOAD    s0, ascii_k
                CALL    send_uart_byte
                CALL    print_newline
                RETURN

