flowchart LR
    codec["SSM2603 Audio Codec IC<br/>Mic input / Speaker output"]

    subgraph fpga["Anvyl FPGA / sound_system_top.v"]
        direction LR
        subgraph clocks["Clock / Reset"]
            proj["Project Clock Wizard<br/>37.5 MHz mem_sys_clk -> clk_codec_ref"]
            cpll["Codec Clock Wizard<br/>clk_codec_ref -> clk_audio + clk_codec_main"]
            ctrl["Top Control Inputs<br/>sys_rst, monitor, tone, volume[3:0]"]
        end

        cfg["I2C_AV_CONFIG.v<br/>I2C_CONTROLLER.v<br/>codec register setup"]
        ac["AUDIO_CODEC.v<br/>serial audio interface<br/>LRCK / BCLK / ADC / DAC"]
        path["AUDIO_SAMPLE_PATH.v<br/>record/playback bridge<br/>volume + monitor + test tone"]
        mem["Recorder / Memory Controller<br/>Person 2 integration point"]
    end

    mem -->|"mem_sys_clk"| proj
    proj -->|"clk_codec_ref"| cpll
    cpll -->|"clk_codec_main"| cfg
    cpll -->|"clk_audio"| ac
    cpll -->|"clk_audio"| path
    cpll -->|"aud_xck"| codec

    cfg -->|"aud_i2c_sclk, aud_i2c_sdat"| codec
    codec -->|"AUD_ADCLRCK, AUD_ADCDAT"| ac
    ac -->|"AUD_DACLRCK, AUD_DACDAT, AUD_BCLK"| codec

    ac -->|"adc_sample[15:0]"| path
    path -->|"dac_sample[15:0]"| ac
    ac -->|"aud_sample_end[1], aud_sample_req[1]"| path

    ctrl -->|"sys_rst + mode controls"| path
    path -->|"rec_sample_data[15:0], rec_sample_valid, rec_sample_tog"| mem
    mem -->|"pb_sample_data[15:0], pb_path_en, latched_vol[3:0]"| path
    path -->|"pb_req_tog"| mem
